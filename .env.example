# Allied School Management System — Environment Variables
# This file lists only variables actually read by the current codebase
# (verified by searching for every `process.env.*` reference in src/).
# This application uses Firebase (Cloud Firestore + Firebase Authentication) —
# there is no SQL/Prisma database and no DATABASE_URL.
#
# Copy this file to .env.local for local development. Never commit real
# secrets — this file must only ever contain placeholder values.

# -----------------------------------------------------------------------
# SESSION SECURITY (required)
# -----------------------------------------------------------------------
# Signs the "allied_session" auth cookie (src/lib/firebase/server-auth.ts,
# src/middleware.ts). Must be a random string of at least 32 characters.
# In production the app refuses to start without a valid value.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# -----------------------------------------------------------------------
# INSTITUTION REGISTRATION (required to provision new schools)
# -----------------------------------------------------------------------
# One-time setup secret required by POST /api/auth/register (the page URL is public and is
# NOT a control). Minimum 16 characters, e.g. `openssl rand -base64 24`. Each value can create
# exactly ONE institution; set a new value to register another school, then remove it.
SCHOOL_REGISTRATION_SECRET="replace-with-a-secure-random-secret-key"

# -----------------------------------------------------------------------
# FIREBASE ADMIN (server-side — required for real Firestore/Auth access)
# -----------------------------------------------------------------------
# Used by src/lib/firebase/admin.ts to initialize the Firebase Admin SDK.
# Without these, the app falls back to an in-memory dev store and refuses
# to start in production (see assertProductionDbReady()).
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Paste the full private key from your Firebase service account JSON, keeping
# the \n line breaks escaped exactly as Firebase exports them.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: alternate ways to authenticate the Admin SDK instead of the three
# variables above (src/lib/firebase/admin.ts) — a local Firestore emulator,
# or a path to a service-account JSON file via Application Default
# Credentials. Leave unset for a normal deployment.
# FIRESTORE_EMULATOR_HOST="localhost:8080"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Optional: server-side fallback API key used only if
# NEXT_PUBLIC_FIREBASE_API_KEY (below) is not set (src/app/api/auth/login/route.ts).
# Normally you only need NEXT_PUBLIC_FIREBASE_API_KEY.
# FIREBASE_API_KEY="AIzaSy...your-firebase-web-api-key"

# -----------------------------------------------------------------------
# FIREBASE CLIENT (public — required, sent to the browser)
# -----------------------------------------------------------------------
# Used by src/lib/firebase/config.ts to initialize the Firebase client SDK
# (Auth, Firestore, Storage). These are public by design (NEXT_PUBLIC_*),
# the same way any Firebase web app's config is public — access is enforced
# by Firebase Auth + Firestore Security Rules, not by hiding these values.
#
# IMPORTANT: these six variables are REQUIRED in production. Because
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, the
# app refuses to build in production (NODE_ENV=production) if any of them
# are missing, rather than silently falling back to a placeholder Firebase
# project. Local development keeps a placeholder fallback so a fresh clone
# still runs before Firebase is configured.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy...your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# Optional: Google Analytics measurement ID for the Firebase project.
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: Firebase App Check (reCAPTCHA v3) site key. When unset or set to
# "none", App Check initialization is skipped (src/lib/firebase/config.ts).
# NEXT_PUBLIC_FIREBASE_APP_CHECK_KEY="none"

# -----------------------------------------------------------------------
# EMAIL DELIVERY (required in production for password reset emails)
# -----------------------------------------------------------------------
# Password reset and teacher account-activation emails are sent by
# src/lib/account-email.ts. Configure ONE of the providers below (both may be
# set; Resend is tried first, then SMTP) to send the app's own branded email
# with a single-use link to /reset-password.
# With neither configured (or if they fail), the app falls back to Firebase
# Authentication's built-in password email (accounts:sendOobCode), which needs
# no extra variables — only the Firebase Admin + NEXT_PUBLIC_FIREBASE_API_KEY
# values above and the Email/Password sign-in provider enabled in Firebase.
# Failures are written to the server log and the Audit Log
# (PASSWORD_RESET_EMAIL_FAILED / ACCOUNT_ACTIVATION_EMAIL_FAILED); local
# development without any channel prints the link to the dev server console.
#
# Option A — Resend (https://resend.com). EMAIL_FROM must be an address on a
# domain you have verified in Resend; Resend rejects unverified senders.
# Required for STUDENT password resets: a student's link goes to the guardian
# email on file, which Firebase's built-in mailer (above) cannot send to.
# Example: EMAIL_FROM="Allied School <no-reply@your-verified-domain.com>"
RESEND_API_KEY=
EMAIL_FROM=
#
# Option B — any SMTP server (e.g. Gmail with an App Password: host
# smtp.gmail.com, port 465, SMTP_SECURE="true"). EMAIL_FROM is optional here
# and defaults to SMTP_USER.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-account@gmail.com"
# SMTP_PASS="your-app-password"

# Public base URL used inside reset links. REQUIRED in production unless the
# app runs on Vercel (VERCEL_PROJECT_PRODUCTION_URL is then used). Must be the
# real https domain — localhost is refused in production, and request Host
# headers are never trusted for this. Example: https://your-production-domain.com
NEXT_PUBLIC_APP_URL=

# DEFAULT_STUDENT_INITIAL_PASSWORD is no longer used: every enrolled / imported student now gets
# a unique random initial password, shown once to the admin.

# -----------------------------------------------------------------------
# Security options (see ALLIED_SECURITY_REPORT.md)
# -----------------------------------------------------------------------
# TOTP two-factor for ADMIN accounts. When "true", admins can enrol in Settings and enrolled
# admins must enter a 6-digit code at sign-in. Default off.
# ADMIN_MFA_ENABLED="false"
# Re-authentication for sensitive admin actions (payroll, fees, deletes, settings): the admin
# must have signed in within this many minutes. Unset/0 = off.
# ADMIN_REAUTH_MAX_AGE_MINUTES="30"
# Extra origins allowed to make state-changing API calls (comma separated). NEXT_PUBLIC_APP_URL
# is always allowed.
# CSRF_TRUSTED_ORIGINS="https://school.example.com"
# Salt for pseudonymising emails/IPs in security log lines (defaults to JWT_SECRET).
# SECURITY_LOG_SALT="replace-with-a-long-random-value"

# -----------------------------------------------------------------------
# APP ENVIRONMENT
# -----------------------------------------------------------------------
NODE_ENV="production"
