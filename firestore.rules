rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() ? getUserData().role : null;
    }

    function getUserSchoolId() {
      return isAuthenticated() ? getUserData().schoolId : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'TEACHER';
    }

    function isStudent() {
      return isAuthenticated() && getUserRole() == 'STUDENT';
    }

    function isParent() {
      return isAuthenticated() && getUserRole() == 'PARENT';
    }

    function studentData(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data;
    }

    function isParentOfStudentResource() {
      return isParent()
        && getUserSchoolId() == resource.data.schoolId
        && (
          (resource.data.parentUserIds is list && request.auth.uid in resource.data.parentUserIds)
          || (
            resource.data.guardianEmail is string
            && resource.data.guardianEmail.lower() == getUserData().email.lower()
          )
        );
    }

    function isParentOfStudentId(studentId) {
      return isParent()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && getUserSchoolId() == studentData(studentId).schoolId
        && (
          (studentData(studentId).parentUserIds is list && request.auth.uid in studentData(studentId).parentUserIds)
          || (
            studentData(studentId).guardianEmail is string
            && studentData(studentId).guardianEmail.lower() == getUserData().email.lower()
          )
        );
    }

    // The teacher record id linked to the caller's login profile ('' when none).
    function callerTeacherId() {
      return getUserData().get('teacherId', '');
    }

    // A teacher may read an attendance record only for their own register: a subject register
    // of a subject allocated to them (subjects.teacherId), or the daily register (no subjectId)
    // of a class they are incharge of (classes.classTeacherId). Mirrors /api/attendance.
    function teacherOwnsAttendanceRegister() {
      return callerTeacherId() != '' && (
        (
          resource.data.get('subjectId', '') != ''
          && get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.get('teacherId', '') == callerTeacherId()
          && get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.classId == resource.data.classId
        ) || (
          resource.data.get('subjectId', '') == ''
          && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.get('classTeacherId', '') == callerTeacherId()
        )
      );
    }


    // -------------------------------------------------------------
    // Defense-in-depth: All mutations (create, update, delete) are
    // executed exclusively server-side through Next.js API routes using
    // Firebase Admin SDK (which bypasses security rules). Direct
    // client-side writes are strictly disallowed across all collections
    // to prevent bypassing API validation, rate limiting, and RBAC.
    // -------------------------------------------------------------

    // -------------------------------------------------------------
    // Schools Collection
    // -------------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if isAuthenticated() && (getUserSchoolId() == schoolId || resource == null);
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      // Profiles hold bcrypt password hashes, 2FA secrets and session-revocation state. The
      // browser only ever reads its own profile (src/lib/firebase/auth-context.tsx); everything
      // else goes through the API. Teachers and admins previously could read every profile in
      // the school, including other users' password hashes.
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Students Collection
    // -------------------------------------------------------------
    match /students/{studentId} {
      // Teachers are not given direct reads: the API limits them to their allocated classes,
      // which a school-wide rule here would bypass.
      allow read: if isAuthenticated() && (
        (isAdmin() && getUserSchoolId() == resource.data.schoolId) ||
        (isStudent() && (resource.data.userId == request.auth.uid || resource.data.id == getUserData().studentId)) ||
        isParentOfStudentResource()
      );
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Teachers Collection
    // -------------------------------------------------------------
    match /teachers/{teacherId} {
      // Teacher records include salary and contact details: admins of the school, or the
      // teacher themself. Students and parents previously could read every teacher's salary.
      allow read: if isAuthenticated() && getUserSchoolId() == resource.data.schoolId
        && (isAdmin() || (isTeacher() && callerTeacherId() == teacherId));
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Classes Collection
    // -------------------------------------------------------------
    match /classes/{classId} {
      allow read: if isAuthenticated() && getUserSchoolId() == resource.data.schoolId;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Subjects Collection
    // -------------------------------------------------------------
    match /subjects/{subjectId} {
      // Teachers only see the subjects allocated to them.
      allow read: if isAuthenticated() && getUserSchoolId() == resource.data.schoolId
        && (!isTeacher() || (callerTeacherId() != '' && resource.data.get('teacherId', '') == callerTeacherId()));
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Timetables Collection
    // -------------------------------------------------------------
    match /timetables/{entryId} {
      // Admins read their school's timetable; a teacher only their own slots.
      allow read: if isAuthenticated() && getUserSchoolId() == resource.data.schoolId
        && (isAdmin() || (isTeacher() && callerTeacherId() != '' && resource.data.teacherId == callerTeacherId()));
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Attendance Collection
    // -------------------------------------------------------------
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        (isAdmin() && getUserSchoolId() == resource.data.schoolId) ||
        (isTeacher() && getUserSchoolId() == resource.data.schoolId && teacherOwnsAttendanceRegister()) ||
        (isStudent() && resource.data.studentId == getUserData().studentId) ||
        isParentOfStudentId(resource.data.studentId)
      );
      // No client may write attendance directly — not even within the 24-hour teacher window.
      // All writes go through /api/attendance, which enforces the lock: a TEACHER can create or
      // change a record only within 24h of it first being marked (createdAt); after that only
      // an ADMIN can change it (src/lib/attendance-lock.ts).
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Fee Challans Collection
    // -------------------------------------------------------------
    match /feeChallans/{challanId} {
      allow read: if isAuthenticated() && (
        (isAdmin() && getUserSchoolId() == resource.data.schoolId) ||
        (isStudent() && resource.data.studentId == getUserData().studentId) ||
        isParentOfStudentId(resource.data.studentId)
      );
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Payments Collection
    // -------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        (isAdmin() && getUserSchoolId() == resource.data.schoolId) ||
        (isStudent() && resource.data.studentId == getUserData().studentId) ||
        isParentOfStudentId(resource.data.studentId)
      );
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Exams Collection
    // -------------------------------------------------------------
    match /exams/{examId} {
      allow read: if isAuthenticated() && getUserSchoolId() == resource.data.schoolId;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Exam Schedules Collection
    // -------------------------------------------------------------
    match /examSchedules/{scheduleId} {
      allow read: if isAuthenticated() && getUserSchoolId() == resource.data.schoolId;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Exam Results Collection
    // -------------------------------------------------------------
    match /examResults/{resultId} {
      allow read: if isAuthenticated() && (
        (isAdmin() && getUserSchoolId() == resource.data.schoolId) ||
        (isTeacher() && getUserSchoolId() == resource.data.schoolId && teacherOwnsAttendanceRegister()) ||
        (isStudent() && resource.data.studentId == getUserData().studentId) ||
        isParentOfStudentId(resource.data.studentId)
      );
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Student Observations Collection
    // -------------------------------------------------------------
    match /studentObservations/{obsId} {
      // Teachers read observations through the API (class-scoped), not directly.
      allow read: if isAuthenticated() && (
        (isAdmin() && getUserSchoolId() == resource.data.schoolId) ||
        (isStudent() && resource.data.studentId == getUserData().studentId)
      );
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Locked Records Collection
    // -------------------------------------------------------------
    match /lockedRecords/{recordId} {
      allow read: if isAuthenticated() && (
        (isAdmin() && getUserSchoolId() == resource.data.schoolId) ||
        (isStudent() && resource.data.studentId == getUserData().studentId)
      );
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Audit Logs Collection (Immutable Trail)
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin() && getUserSchoolId() == resource.data.schoolId;
      allow write: if false; // Immutable
    }

    // -------------------------------------------------------------
    // School Settings Collection
    // -------------------------------------------------------------
    match /schoolSettings/{settingsId} {
      allow read: if isAuthenticated() && getUserSchoolId() == resource.data.schoolId;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Announcements Collection
    // -------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAuthenticated()
        && getUserSchoolId() == resource.data.schoolId
        && (
          isAdmin()
          || (
            resource.data.status == 'PUBLISHED'
            && (
              resource.data.audience == 'EVERYONE'
              || (resource.data.audience == 'TEACHERS' && isTeacher())
              || (resource.data.audience == 'STUDENTS' && isStudent())
              || (resource.data.audience == 'PARENTS' && isParent())
            )
          )
        );
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Everything not matched above (payrollRecords, passwordResetTokens, registrationSecrets and
    // any future collection) is denied: Firestore rules deny every path no rule allows.
    // -------------------------------------------------------------
  }
}
